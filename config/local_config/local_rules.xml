<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>
<group name="local,sca,compliance,">

  <rule id="100510" level="6">
    <decoded_as>sca</decoded_as>

    <field name="data.sca.check.result">failed</field>

    <description>SCA FAILED: CIS Amazon Linux 2023 misconfiguration detected</description>
    <group>sca,compliance,critical,</group>
  </rule>

  <rule id="100511" level="7">
    <decoded_as>sca</decoded_as>
    <field name="data.sca.check.result">not applicable</field>

    <description>SCA: CIS check not applicable (verify manually)</description>
    <group>sca,compliance,info,</group>
  </rule>
</group>

<group name="local,postfix,journald,">

  <rule id="100600" level="8">
    <decoded_as>postfix</decoded_as>
    <match>reload -- version</match>
    <description>Postfix reload detected (postfix/master)</description>
    <group>mail,postfix,</group>
  </rule>

</group>

<group name="local,systemd,journald,">

  <rule id="100601" level="9">
    <decoded_as>systemd</decoded_as>
    <match>Postfix Mail Transport Agent</match>
    <description>Postfix Mail Transport Agent reloaded via systemd</description>
    <group>mail,postfix,systemd,</group>
  </rule>

</group>
<group name="local,apache,web,">

  <rule id="100610" level="3">
    <decoded_as>web-accesslog</decoded_as>

    <field name="data.id">302</field>

    <field name="data.url">/</field>

    <description>Apache: HTTP 302 on root path</description>
    <group>apache,web,accesslog,</group>
  </rule>

</group>
<group name="local,apache,accesslog,">

  <rule id="100700" level="3">

    <decoded_as>web-accesslog</decoded_as>

    <field name="location">/var/log/app/apache/access.log</field>

    <description>Apache access log event from wazuh-agent-dmz</description>
    <group>web,apache,accesslog,</group>
  </rule>

</group>
<group name="local,modsecurity,web,">
  <rule id="100801" level="9">
    <decoded_as>modsecurity-audit</decoded_as>
    <field name="modsec_id">949110</field>
    <description>ModSecurity detected SQL Injection</description>
    <group>waf,modsecurity,attack,sqli,</group>
  </rule>
</group>